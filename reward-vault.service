[Unit]
Description=Reward Vault Backend
# Start after Pi-hole's API is up. Without this the app can run its first reconcile
# a couple of seconds before pihole-FTL is listening, record "fetch failed", and show
# a stale "Pi-hole unreachable" status until something triggers another reconcile.
After=network.target pihole-FTL.service
Wants=pihole-FTL.service

[Service]
Type=simple
# Adjust User and WorkingDirectory to match your Pi setup
User=pi
WorkingDirectory=/home/pi/reward-vault
# Pass Habitica credentials via environment
Environment="HABITICA_USER_ID=PASTE_YOUR_USER_ID_HERE"
Environment="HABITICA_API_KEY=PASTE_YOUR_API_KEY_HERE"
Environment="PORT=3000"
# Pi-hole enforcement secret (the app also auto-loads ./.env; this is belt-and-suspenders).
# The leading '-' makes it optional so the service still starts without the file.
EnvironmentFile=-/home/pi/reward-vault/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
